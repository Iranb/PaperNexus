{
  "name": "papernexus",
  "version": "0.1.0",
  "description": "Serverless knowledge graph framework for academic PDFs, inspired by GitNexus and powered by Marker.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "bin": {
    "papernexus": "./src/cli/index.js"
  },
  "scripts": {
    "analyze:examples": "node ./src/cli/index.js analyze ./examples --name sample-papers",
    "docs:generate": "node ./scripts/generate-docs-reference.mjs",
    "docs:dev": "npm run docs:generate && vitepress dev docs",
    "docs:build": "npm run docs:generate && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "reinstall": "bash ./scripts/reinstall.sh",
    "test": "node --test $(find test -name '*.test.js' -print)",
    "serve": "node ./src/cli/index.js serve",
    "mcp": "node ./src/cli/index.js mcp"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "jsonrepair": "^3.13.1",
    "kuzu": "^0.11.3",
    "ngraph.graph": "^20.1.2",
    "ngraph.leiden": "^0.2.0",
    "playwright-core": "^1.59.1"
  },
  "devDependencies": {
    "vitepress": "^1.6.4"
  }
}
