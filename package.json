{
  "name": "papernexus",
  "version": "0.1.0",
  "description": "Serverless knowledge graph framework for academic PDFs, inspired by GitNexus and powered by Marker.",
  "type": "module",
  "bin": {
    "papernexus": "./src/cli/index.js"
  },
  "scripts": {
    "analyze:examples": "node ./src/cli/index.js analyze ./examples --name sample-papers",
    "reinstall": "bash ./scripts/reinstall.sh",
    "test": "node --test",
    "serve": "node ./src/cli/index.js serve",
    "mcp": "node ./src/cli/index.js mcp"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "jsonrepair": "^3.13.1",
    "kuzu": "^0.11.3",
    "ngraph.graph": "^20.1.2",
    "ngraph.leiden": "^0.2.0"
  }
}
