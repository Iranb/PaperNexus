            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "context"
              }
            }
          },
          "then": {
            "required": [
              "query"
            ],
            "properties": {
              "targetDomain": false,
              "constraints": false,
              "maxDepth": false,
              "maxNodes": false,
              "maxEdges": false,
              "seedNodeIds": false,
              "fromYear": false,
