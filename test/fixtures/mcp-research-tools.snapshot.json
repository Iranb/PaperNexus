  {
    "name": "lineage_analysis",
    "description": "Analyze research evolution from committed evidence: overview maps a bounded topic graph; problem gives dated problem observations; method traces validated method lineage; evidence checks method-edge quotes; path/context/impact inspect graph connections. A graph path is not causal proof, and bounded endpoints are not global frontiers. Use literature_review for missing papers and idea_generation for proposals.",
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "openWorldHint": false
    },
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operation": {
          "type": "string",
          "enum": [
            "overview",
            "problem",
            "method",
            "evidence",
            "path",
            "context",
            "impact"
          ],
          "description": "overview: corpus, query, targetDomain, constraints, maxDepth, maxNodes, maxEdges, seedNodeIds, fromYear, toYear; problem: corpus, query, targetDomain, constraints, maxDepth, maxNodes, maxEdges, seedNodeIds, fromYear, toYear; method: corpus, query, method, direction, maxDepth, limit; evidence: corpus, query, method, sourceMethod, targetMethod, edgeId, limit; path: corpus, from, to, maxDepth, limit, layers; context: corpus, query, layers; impact: corpus, query, direction, maxDepth, layers"
        },
        "corpus": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000,
          "description": "Corpus name or indexed root. Use literature_review/corpora when unknown."
        },
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000,
          "description": "Research topic, question, or exact node anchor."
        },
        "targetDomain": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000,
          "description": "Target research domain; generate uses cross-domain catalyst when supplied."
        },
        "constraints": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 8000,
              "description": "Conditions to respect"
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8000,
                "description": "Value"
              },
              "maxItems": 30,
              "description": "Conditions to respect"
            },
            {
              "type": "object",
              "maxProperties": 30,
              "additionalProperties": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8000,
                    "description": "Required condition value"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  }
                ]
              }
            }
          ],
          "description": "Source-review conditions. Lineage overview/problem also accept up to 30 primitive method requirements, such as labelsAvailable=false or maxLatencyMs=40."
        },
        "maxDepth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4,
          "description": "Bounded graph traversal depth, default 2; never global frontier proof."
        },
        "maxNodes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500,
          "description": "Topic subgraph node budget, default 180."
        },
        "maxEdges": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "description": "Topic subgraph edge budget, default 350."
        },
        "seedNodeIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000,
            "description": "Value"
          },
          "maxItems": 30,
          "description": "Explicit graph node anchors for a topic overview."
        },
        "fromYear": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 9999,
          "description": "Inclusive topic observation lower year."
        },
        "toYear": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 9999,
          "description": "Inclusive topic observation upper year."
        },
        "method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000,
          "description": "Exact method id or method name."
        },
        "direction": {
          "type": "string",
          "enum": [
            "backward",
            "forward",
            "both"
          ],
          "description": "Method/evidence direction. Impact accepts backward or forward only."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20,
          "description": "Result budget, default 5."
        },
        "sourceMethod": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000,
          "description": "Source method for an exact evidence edge lookup."
        },
        "targetMethod": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000,
          "description": "Target method for an exact evidence edge lookup."
        },
        "edgeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000,
          "description": "Exact method evolution edge id."
        },
        "from": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000,
          "description": "Starting graph node for path."
        },
        "to": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000,
          "description": "Ending graph node for path."
        },
        "layers": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000,
          "description": "Comma-separated graph layer filter."
        }
      },
      "required": [
        "operation"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "operation": {
                "const": "overview"
              }
            }
          },
          "then": {
            "properties": {
              "method": false,
              "direction": false,
              "limit": false,
              "sourceMethod": false,
              "targetMethod": false,
              "edgeId": false,
              "from": false,
              "to": false,
              "layers": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "problem"
              }
            }
          },
          "then": {
            "required": [
              "query"
            ],
            "properties": {
              "method": false,
              "direction": false,
              "limit": false,
              "sourceMethod": false,
              "targetMethod": false,
              "edgeId": false,
              "from": false,
              "to": false,
              "layers": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "method"
              }
            }
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "query"
                ]
              },
              {
                "required": [
                  "method"
                ]
              }
            ],
            "properties": {
              "targetDomain": false,
              "constraints": false,
              "maxNodes": false,
              "maxEdges": false,
              "seedNodeIds": false,
              "fromYear": false,
              "toYear": false,
              "sourceMethod": false,
              "targetMethod": false,
              "edgeId": false,
              "from": false,
              "to": false,
              "layers": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "evidence"
              }
            }
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "query"
                ]
              },
              {
                "required": [
                  "method"
                ]
              },
              {
                "required": [
                  "sourceMethod"
                ]
              },
              {
                "required": [
                  "targetMethod"
                ]
              },
              {
                "required": [
                  "edgeId"
                ]
              }
            ],
            "properties": {
              "targetDomain": false,
              "constraints": false,
              "maxDepth": false,
              "maxNodes": false,
              "maxEdges": false,
              "seedNodeIds": false,
              "fromYear": false,
              "toYear": false,
              "direction": false,
              "from": false,
              "to": false,
              "layers": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "path"
              }
            }
          },
          "then": {
            "required": [
              "from",
              "to"
            ],
            "properties": {
              "query": false,
              "targetDomain": false,
              "constraints": false,
              "maxNodes": false,
              "maxEdges": false,
              "seedNodeIds": false,
              "fromYear": false,
              "toYear": false,
              "method": false,
