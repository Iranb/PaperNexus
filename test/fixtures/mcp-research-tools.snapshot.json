[
  {
    "name": "literature_review",
    "description": "Find and read papers, assemble a source-backed survey, and explicitly discover/import missing papers. corpora/status/sources inspect coverage; search reads the committed graph; paper reads source material; survey groups relevant evidence. discover submits a network job, discovery_status/report inspect it, import explicitly queues a staged file or resolved run, import_status tracks jobs/tasks. Discovery is not graph evidence until import and authoritative sync complete.",
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "openWorldHint": true
    },
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operation": {
          "type": "string",
          "enum": [
            "corpora",
            "status",
            "sources",
            "search",
            "paper",
            "survey",
            "discover",
            "discovery_status",
            "discovery_report",
            "import",
            "import_status"
          ],
          "description": "corpora: corpus; status: corpus; sources: corpus; search: corpus, query, limit, layers, sortBy; paper: corpus, query, paperId, identifier, chunkLimit; survey: corpus, query, targetDomain, constraints, limit; discover: corpus, query, discoveryMode, providers, maxPapers; discovery_status: corpus, runId, limit; discovery_report: corpus, runId; import: corpus, serverFilePath, runId, doi, arxivId, idempotencyKey; import_status: corpus, jobId, taskId, taskIds"
        },
        "corpus": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000,
          "description": "Corpus name or indexed root. Use literature_review/corpora when unknown."
        },
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000,
          "description": "Research topic, question, or exact node anchor."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20,
          "description": "Result budget, default 5."
        },
        "layers": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000,
          "description": "Comma-separated graph layer filter."
        },
        "sortBy": {
          "type": "string",
          "enum": [
            "relevance",
            "date"
          ],
          "description": "Committed search ranking; defaults to relevance."
        },
        "paperId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000,
          "description": "Exact committed paper id."
        },
        "identifier": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000,
          "description": "Exact paper identifier such as DOI or arXiv id."
        },
        "chunkLimit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 40,
          "description": "Maximum source chunks in a paper view."
        },
        "targetDomain": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000,
          "description": "Target research domain; generate uses cross-domain catalyst when supplied."
        },
        "constraints": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 8000,
              "description": "Conditions to respect"
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8000,
                "description": "Value"
              },
              "maxItems": 30,
              "description": "Conditions to respect"
            }
          ],
          "description": "Free-text source-review conditions; structured method requirements belong to lineage_analysis/overview or problem."
        },
        "discoveryMode": {
          "type": "string",
          "enum": [
            "search",
            "resolve",
            "run"
          ],
          "description": "search finds metadata; resolve/run can fetch full text. Submitted asynchronously; never imports automatically."
        },
        "providers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000,
            "description": "Value"
          },
          "maxItems": 30,
          "description": "Optional discovery provider names."
        },
        "maxPapers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "description": "Maximum discovery papers; default 20."
        },
        "runId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Existing literature discovery run id.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "serverFilePath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000,
          "description": "Already staged server-side PDF/Markdown file to import."
        },
        "doi": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000,
          "description": "Optional DOI for an imported source."
        },
        "arxivId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000,
          "description": "Optional arXiv id for an imported source."
        },
        "idempotencyKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Stable id for an import submission; reuse to avoid duplicate async jobs."
        },
        "jobId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000,
          "description": "Durable asynchronous import submission job id."
        },
        "taskId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000,
          "description": "Import task id from the authoritative queue."
        },
        "taskIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000,
            "description": "Value"
          },
          "maxItems": 100,
          "description": "Import task ids from a saved discovery run.",
          "minItems": 1
        }
      },
      "required": [
        "operation"
      ],
      "allOf": [
